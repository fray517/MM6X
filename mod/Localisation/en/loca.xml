<Localization xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <LocaData id="LOCATION_MM6_NEW_SORPIGAL">New Sorpigal</LocaData>
  <LocaData id="WORLDMAP_MM6_NEW_SORPIGAL">New Sorpigal</LocaData>
  <LocaData id="LOCATION_MM6_GOBLINWATCH">Goblinwatch</LocaData>
  <LocaData id="LOCATION_MM6_NEW_SORPIGAL_TOWN_HALL">Town Hall</LocaData>
  <LocaData id="NPC_NAME_MM6_JANIS">Janis</LocaData>
  <LocaData id="NPC_NAME_MM6_ANDOVER">Andover Potbello</LocaData>
  <LocaData id="TOKEN_MM6_GOBLINWATCH">Goblinwatch</LocaData>
  <LocaData id="QUEST_STEP_MM6_GOBLINWATCH_NAME">The Goblinwatch combination</LocaData>
  <LocaData id="QUEST_STEP_MM6_GOBLINWATCH_FLAVOR">Find the combination to the vault in Goblinwatch and return to the Town Hall in New Sorpigal.</LocaData>
  <LocaData id="QUEST_STEP_MM6_GOBLINWATCH_SHORT">Retrieve the Goblinwatch combination.</LocaData>
  <LocaData id="QUEST_OBJECTIVE_MM6_GOBLINWATCH_ACCEPT">Enter Goblinwatch and recover the combination.</LocaData>
  <LocaData id="QUEST_OBJECTIVE_MM6_GOBLINWATCH_TURNIN">Return the Goblinwatch codex to Janis at the Town Hall.</LocaData>
  <LocaData id="TOKEN_MM6_GOBLINWATCH_KEY">Goblinwatch Key</LocaData>
  <LocaData id="TOKEN_MM6_GOBLINWATCH_CODEX">Goblinwatch Codex</LocaData>
  <LocaData id="LOREBOOK_TITLE_MM6_GOBLINWATCH_CODEX">Goblinwatch Codex</LocaData>
  <LocaData id="LOREBOOK_TEXT_MM6_GOBLINWATCH_CODEX">Letter-plate legend (this build uses А–П, not a typed password).\n\nА: trap.\nБ: opens door 4, closes door 5.\nВ: opens door 5, closes door 4.\nД: opens door 1, closes door 5.\nЕ: opens door 5, closes door 1.\nЖ: opens door 2, closes door 4.\nГ: opens door 6.\nЗ: opens door 3, closes door 2.\nИ: opens door 2, closes door 3.\nЙ: opens door 2, closes door 1.\nК: opens door 6, closes door 5.\nЛ: opens door 3, closes door 4.\nМ: maintenance (teleport).\nН: opens door 1, closes door 2.\nО: opens door 5, closes door 6.\nП: reset.</LocaData>
  <LocaData id="TOKEN_MM6_SULMAN_LETTER_QUEST">Sulman's Letter</LocaData>
  <LocaData id="QUEST_STEP_MM6_SULMAN_LETTER_NAME">Sulman's letter</LocaData>
  <LocaData id="QUEST_STEP_MM6_SULMAN_LETTER_FLAVOR">Andover gave you a sealed letter for Sulman. Deliver it when you leave New Sorpigal.</LocaData>
  <LocaData id="QUEST_STEP_MM6_SULMAN_LETTER_SHORT">Deliver Sulman's letter.</LocaData>
  <LocaData id="QUEST_OBJECTIVE_MM6_SULMAN_LETTER">Keep Sulman's letter and deliver it later.</LocaData>
  <LocaData id="TOKEN_MM6_SULMAN_LETTER">Letter for Sulman</LocaData>
  <LocaData id="LOREBOOK_AUTHOR_MM6_GOBLINWATCH_CODEX">Monks of Drokka</LocaData>
  <LocaData id="DIALOG_TEXT_MM6_JANIS_GREETING">Welcome to the Town Hall. I am Janis, clerk of New Sorpigal.</LocaData>
  <LocaData id="DIALOG_OPTION_MM6_JANIS_GOBLINWATCH">Tell me about the Goblinwatch.</LocaData>
  <LocaData id="DIALOG_OPTION_MM6_JANIS_TURNIN">I found the Goblinwatch codex.</LocaData>
  <LocaData id="DIALOG_OPTION_MM6_JANIS_PROGRESS">About the Goblinwatch…</LocaData>
  <LocaData id="DIALOG_OPTION_MM6_JANIS_GOODBYE">Goodbye.</LocaData>
  <LocaData id="DIALOG_TEXT_MM6_JANIS_GOBLINWATCH_OFFER">Goblins hold an old watchtower east of town. We need the combination to their vault. Will you retrieve it?</LocaData>
  <LocaData id="DIALOG_OPTION_MM6_JANIS_ACCEPT">I will help.</LocaData>
  <LocaData id="DIALOG_OPTION_MM6_JANIS_DECLINE">Not now.</LocaData>
  <LocaData id="DIALOG_TEXT_MM6_JANIS_GOBLINWATCH_ACCEPTED">Thank you. Take this key to the Goblinwatch entrance. Return with the codex.</LocaData>
  <LocaData id="DIALOG_OPTION_MM6_JANIS_TAKE_KEY">I will take the key.</LocaData>
  <LocaData id="DIALOG_TEXT_MM6_JANIS_PROGRESS">The east road leads to Goblinwatch. Use the key, find the vault combination, and bring the codex here.</LocaData>
  <LocaData id="DIALOG_TEXT_MM6_JANIS_TURNIN_PROMPT">Do you have the Goblinwatch codex for the vault combination?</LocaData>
  <LocaData id="DIALOG_OPTION_MM6_JANIS_TURNIN_SUBMIT">Here is the codex.</LocaData>
  <LocaData id="DIALOG_TEXT_MM6_JANIS_TURNIN_DONE">Excellent work. The town is in your debt — gold and experience are yours.</LocaData>
  <LocaData id="DIALOG_TEXT_MM6_ANDOVER_GREETING">Andover Potbello at your service. The Lonely Knight has rooms, gossip, and errands.</LocaData>
  <LocaData id="DIALOG_OPTION_MM6_ANDOVER_LETTER">Do you have a letter for Sulman?</LocaData>
  <LocaData id="DIALOG_OPTION_MM6_ANDOVER_LETTER_STATUS">About Sulman's letter…</LocaData>
  <LocaData id="DIALOG_OPTION_MM6_ANDOVER_GOODBYE">Goodbye.</LocaData>
  <LocaData id="DIALOG_TEXT_MM6_ANDOVER_LETTER_OFFER">Yes — a sealed note for Sulman. Carry it for me and keep it safe. Delivery is beyond this town slice.</LocaData>
  <LocaData id="DIALOG_OPTION_MM6_ANDOVER_ACCEPT">I will take the letter.</LocaData>
  <LocaData id="DIALOG_OPTION_MM6_ANDOVER_DECLINE">Not right now.</LocaData>
  <LocaData id="DIALOG_TEXT_MM6_ANDOVER_LETTER_ACCEPTED">Good. Here is the letter. Find Sulman when your road allows — and do not open it.</LocaData>
  <LocaData id="DIALOG_TEXT_MM6_ANDOVER_LETTER_HELD">You already carry Sulman's letter. Safe travels.</LocaData>
  <LocaData id="SIGN_MM6_NEW_SORPIGAL_TOWN_HALL">Town Hall</LocaData>
  <LocaData id="SIGN_MM6_NEW_SORPIGAL_TAVERN">The Lonely Knight</LocaData>
  <LocaData id="SIGN_MM6_NEW_SORPIGAL_GOBLINWATCH_GATE">Goblinwatch — locked</LocaData>
  <LocaData id="SIGN_MM6_NEW_SORPIGAL_STABLES">Stables (travel stub)</LocaData>
  <LocaData id="SIGN_MM6_NEW_SORPIGAL_BOATS">Boats (travel stub)</LocaData>
  <LocaData id="SIGN_MM6_NEW_SORPIGAL_ABANDONED_TEMPLE">Abandoned Temple (stub)</LocaData>
  <LocaData id="SIGN_MM6_NEW_SORPIGAL_GARIK_FORGE">Gharik's Forge (stub)</LocaData>
</Localization>
