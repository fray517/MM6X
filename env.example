# Каталог установки Might & Magic X: Legacy.
# Используется, если CLI вызван без --game-path.
# Пример: D:\Games\Might & Magic X - Legacy
MMX_GAME_PATH=C:\Program Files (x86)\Ubisoft\Ubisoft Game Launcher\games\Might & Magic X Legacy

# Каталог уже установленной MM6 (папка с MM6.exe и Data\), не ISO/BIN.
# Пример: D:\GOG Games\Might and Magic 6
MM6_GAME_PATH=C:\Program Files\GOG Galaxy\Games\Might and Magic 6
